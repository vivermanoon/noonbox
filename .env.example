# Copy to .env and adjust. The scaffold reads these if present, but all
# have sensible defaults so .env is optional.

# GCP project to bill/query against.
BQ_PROJECT=noonbimerch

# Path to your OAuth client-secrets JSON downloaded from the GCP console
# (APIs & Services -> Credentials -> OAuth client ID -> "Desktop app").
BQ_CLIENT_SECRETS=client_secret.json

# Where the cached user token is stored after the first login.
BQ_TOKEN_PATH=.bq_token.json

# Optional: default dataset location for jobs (e.g. US, EU, us-central1).
# BQ_LOCATION=US

# Optional: a short-lived OAuth access token. If set, it takes precedence over
# the browser login flow. Get one with:
#   gcloud auth application-default print-access-token
# BQ_ACCESS_TOKEN=ya29....


# ----------------------------------------------------------------------------
# GitLab connection (glconnect)
# ----------------------------------------------------------------------------

# GitLab instance to connect to. Defaults to noon's self-hosted instance.
GITLAB_URL=https://dp-gitlab.noon.team

# OAuth application credentials from GitLab -> Settings -> Applications.
# Register the redirect URI below and tick the scopes you need (e.g. "api").
# CLIENT_SECRET is optional: leave it unset for a non-confidential (PKCE) app.
GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# Where the cached user token is stored after the first login.
GITLAB_TOKEN_PATH=.gitlab_token.json

# Local port / redirect URI used to capture the OAuth callback during login.
# The redirect URI must match one registered on the OAuth application exactly.
GITLAB_REDIRECT_PORT=8080
# GITLAB_REDIRECT_URI=http://localhost:8080/callback

# Space-separated OAuth scopes. "api" = full read/write; "read_api" = read-only.
GITLAB_SCOPES=api

# Optional: a token supplied out-of-band. If set, it takes precedence over the
# browser login flow. Treated as an OAuth token unless GITLAB_TOKEN_TYPE=private
# (in which case it's used as a personal access token).
# GITLAB_ACCESS_TOKEN=
# GITLAB_TOKEN_TYPE=oauth
